# Telegram-бот
BOT_TOKEN=123456:ABC-DEF...
API_BASE_URL=http://localhost:8000

# PostgreSQL (docker compose up -d db). Без Docker можно указать DATABASE_URL=sqlite:///backend/db.sqlite3
DATABASE_URL=postgres://dekanat:dekanat@localhost:5433/dekanat
POSTGRES_DB=dekanat
POSTGRES_USER=dekanat
POSTGRES_PASSWORD=dekanat
POSTGRES_PORT=5433          # порт контейнера на хосте (5433, чтобы не конфликтовать с локальным Postgres)

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# DEKANAT_WARMUP=1            # прогрев OCR при старте
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=./models/tessdata

# Публичный HTTPS-адрес сайта: бот даёт на него ссылку (команда /site и кнопка «Сайт»).
# Поддерживается scripts/tunnel_keeper.py. Открывать через VPN: и с телефона, и с ПК. serveo с именем даёт
# постоянный адрес; localhost.run показывал «no tunnel»; cloudflared работает, только если сам ПК выходит через VPN.
SITE_URL=https://dekanat-ci.serveousercontent.com
TUNNEL_PROVIDER=serveo        # serveo | cloudflared | localhost.run
TUNNEL_NAME=dekanat-ci        # постоянный поддомен serveo (ключ зарегистрирован на console.serveo.net)
# CLOUDFLARED=C:\Program Files (x86)\cloudflared\cloudflared.exe
